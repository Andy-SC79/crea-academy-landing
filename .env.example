# Bootcamp IA: precio comercial en USD y cobro real en COP por TRM.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Ingenieria 365 <cotizaciones@ingenieria365.com>
VITE_PUBLIC_SITE_URL=

# Wompi Colombia. El backend firma el checkout directo en COP.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_REDIRECT_URL=

# TRM publica de Superfinanciera via datos.gov.co.
TRM_API_URL=https://www.datos.gov.co/resource/32sa-8pi3.json?$limit=1&$order=vigenciadesde%20DESC
# Opcional: respaldo manual si datos.gov.co no responde.
TRM_FALLBACK_COP_PER_USD=

# Integracion i365 heredada: solo para consultar precios remotos si se activa.
VITE_I365_PAYMENT_APP_ID=298f0727-6901-4d98-88e0-785576041b20
VITE_I365_BOOTCAMP_PLAN_ID=
VITE_I365_WIDGET_URL=https://pagos.ingenieria365.com/widget.js
I365_PAYMENT_API_URL=https://pagos.ingenieria365.com
I365_PAYMENT_APP_ID=298f0727-6901-4d98-88e0-785576041b20
I365_BOOTCAMP_PLAN_ID=
I365_BOOTCAMP_USE_REMOTE_PRICING=false
