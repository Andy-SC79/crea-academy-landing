# Frontend: widget i365 embebido para pagos por fecha del Bootcamp IA.
# El boton "Pagar ahora" abre PasarelaI365.open() con el planId de la ciudad.
VITE_I365_PAYMENT_APP_ID=298f0727-6901-4d98-88e0-785576041b20
# Los planId del Bootcamp IA se definen por fecha en la pagina y el backend.
VITE_I365_BOOTCAMP_PLAN_ID=
VITE_I365_WIDGET_URL=https://pagos.ingenieria365.com/widget.js

# Backend/fallback: pago dinámico para cotizaciones por cantidad de participantes.
# Mantén este app id alineado con VITE_I365_PAYMENT_APP_ID.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Ingeniería 365 <cotizaciones@ingenieria365.com>
VITE_PUBLIC_SITE_URL=
I365_PAYMENT_API_URL=https://pagos.ingenieria365.com
I365_PAYMENT_APP_ID=298f0727-6901-4d98-88e0-785576041b20
I365_BOOTCAMP_PLAN_ID=
BOOTCAMP_PAYMENT_REDIRECT_URL=
